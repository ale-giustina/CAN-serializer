	(gr_text "Il CAN è come le cipolle...\nPuzza?\nSì... no!\nAh, ti fa piangere?\nNo!\nAh, lo lasci al sole diventa \nmarrone e poi spuntano i peletti bianchi?\nNo! Strati! Il CAN ha gli strati, \nle cipolle hanno gli strati! \nCapite? Tutti e due hanno gli strati!"
		(locked yes)
		(at 195 67.25 0)
		(layer "B.SilkS")
		(uuid "69bf2d73-4ad5-46b6-8b05-67ecf84fe8c3")
